# Local developer defaults
BOT_ENV=dev
BOT_MODE=semi_auto

# CLI/UI database location. Use a dedicated path for smoke runs or demo sandboxes.
BOT_DATABASE_URL=sqlite:///bot.db

# Optional operator UI defaults
BOT_UI_HOST=127.0.0.1
BOT_UI_PORT=8080
BOT_UI_SECURE_COOKIES=false

# Web UI auth bootstrap:
# set BOT_UI_PASSWORD only for a one-shot CLI initialization command like:
# BOT_UI_PASSWORD='...' .venv/bin/bot auth set-password --username osokolin
# Do not commit or persist plaintext passwords in source control.

# Telegram operator inbox (read-only Phase 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
